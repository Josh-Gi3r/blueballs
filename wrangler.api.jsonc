{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blueballs-api",
  "main": "./workers/api/index.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "CLOUDFLARE_WORKER": "true",
    "PORT": "5281",
    "PUBLIC_SITE_URL": "https://blueballs.tech"
  },
  "durable_objects": {
    "bindings": [
      { "name": "BANK_API", "class_name": "BlueballsBankApi" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BlueballsBankApi"] }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 }
  }
}
