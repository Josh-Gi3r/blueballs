{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blueballs-api",
  "main": "./workers/api/index.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "CLOUDFLARE_WORKER": "true",
    "PORT": "5281",
    "PUBLIC_SITE_URL": "https://blueballs.tech",
    "CORS_ORIGINS": "https://blueballs.tech",
    "TRUST_PROXY": "false",
    "WEBHOOK_DELIVERY_MODE": "disabled"
    ,"BLUEBALLS_GIT_SHA": "development"
    ,"SANDBOX_KEY_LIFETIME_HOURS": "24"
  },
  "durable_objects": {
    "bindings": [
      { "name": "BANK_API", "class_name": "BlueballsBankApi" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BlueballsBankApi"] }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 }
  }
}
