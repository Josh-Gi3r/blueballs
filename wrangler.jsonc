{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blueballs",
  "main": "./workers/site/index.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    { "pattern": "blueballs.tech", "custom_domain": true },
    { "pattern": "www.blueballs.tech", "custom_domain": true }
  ],
  "services": [
    { "binding": "API", "service": "blueballs-api" },
    { "binding": "FX", "service": "blueballs-fx" }
  ],
  "ai": { "binding": "AI", "remote": true },
  "durable_objects": {
    "bindings": [
      { "name": "NeobankBuilder", "class_name": "NeobankBuilder" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NeobankBuilder"] }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 }
  }
}
