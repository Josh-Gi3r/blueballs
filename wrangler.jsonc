{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blueballs",
  "main": "./workers/site/index.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "BLUEBALLS_GIT_SHA": "development",
    "BUILDER_AGENT_ENABLED": "true",
    "BUILDER_DAILY_REQUEST_LIMIT": "30",
    "BUILDER_GLOBAL_DAILY_REQUEST_LIMIT": "300",
    "BUILDER_MAX_COMPLETION_TOKENS": "800"
  },
  "routes": [
    { "pattern": "blueballs.tech", "custom_domain": true },
    { "pattern": "www.blueballs.tech", "custom_domain": true }
  ],
  "services": [
    { "binding": "API", "service": "blueballs-api" },
    { "binding": "FX", "service": "blueballs-fx" }
  ],
  "ai": { "binding": "AI", "remote": true },
  "ratelimits": [
    { "name": "BUILDER_SOURCE_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "BUILDER_TENANT_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NeobankBuilder", "class_name": "NeobankBuilder" },
      { "name": "BUILDER_BUDGET", "class_name": "BuilderBudget" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NeobankBuilder"] },
    { "tag": "v2", "new_sqlite_classes": ["BuilderBudget"] }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 }
  }
}
