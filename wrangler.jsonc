{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blueballs",
  "main": "./workers/site/index.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "blueballs.tech", "custom_domain": true },
    { "pattern": "www.blueballs.tech", "custom_domain": true }
  ],
  "vars": {
    "FX_API_KEY": "bb_test_public_fx"
  },
  "services": [
    { "binding": "API", "service": "blueballs-api" },
    { "binding": "FX", "service": "blueballs-fx" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 }
  }
}
