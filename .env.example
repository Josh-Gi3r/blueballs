# Copy to .env and adjust only when needed. The local public stack defaults to
# sandbox mode; production mode deliberately fails closed on sandbox shortcuts.

# --- General banking API (apps/api) ---
PORT=5290
# DB_PATH=./apps/api/blueballs.sqlite
BANK_API_MODE=sandbox
# Fresh production databases require an explicit bootstrap admin secret from the
# deployment secret manager. Use at least 32 characters. Remove it from the
# environment after production IAM/admin credentials have been provisioned.
# BANK_BOOTSTRAP_API_KEY=
# BANK_BOOTSTRAP_TENANT_ID=
# BANK_BOOTSTRAP_EMAIL=
RATE_LIMIT_PER_MIN=300
# SOURCE_RATE_LIMIT_PER_MIN=120
# TENANT_RATE_LIMIT_PER_MIN=300
BODY_LIMIT_BYTES=1048576
CORS_ORIGINS=http://localhost:5280,http://127.0.0.1:5280
TRUST_PROXY=false
# IDEMPOTENCY_TTL_MS=86400000
# Public payment links generated by POST /v2/links. Must be HTTPS outside localhost.
PAYMENT_LINK_BASE_URL=https://blueballs.tech/pay/
# SHA-256 hex digest of the operator key; never store the clear-text key here.
# OPERATOR_API_KEY_HASH=

# --- Production provider gateway ---
# Production external side effects (bank rails, receiving details, card issuance,
# identity verification) use one provider-neutral protocol. Both values are
# required together. Keep the token in a deployment secret manager; do not commit
# a live value. Production requests that require a provider fail closed with 503
# when no gateway is configured.
# BANK_PROVIDER_GATEWAY_URL=https://provider-gateway.example.org/blueballs
# BANK_PROVIDER_GATEWAY_TOKEN=
# BANK_PROVIDER_TIMEOUT_MS=10000
#
# Provider jobs may contain sensitive identity/account/card metadata. Production
# seals the durable provider-outbox payload with AES-256-GCM before it is written.
# Supply exactly 32 bytes encoded as 64 hex characters or base64 through the
# deployment secret manager. Do not put a live key in this file.
# BANK_PROVIDER_PAYLOAD_KEY=
# BANK_PROVIDER_PAYLOAD_ACTIVE_KEY_ID=provider-payload-v1
#
# For rotation, deploy a keyring containing both old and new keys, switch the
# active key id, and retain old keys until no queued/reconciliation job references
# them. Example shape only (values intentionally omitted):
# BANK_PROVIDER_PAYLOAD_KEYS={"provider-payload-v1":"<32-byte-key>","provider-payload-v2":"<32-byte-key>"}
# BANK_PROVIDER_PAYLOAD_ACTIVE_KEY_ID=provider-payload-v2
#
# Retry/reconciliation schedule. A timeout is ambiguous and switches to reconcile
# phase using the same provider job ID as the idempotency key.
# BANK_PROVIDER_RETRY_DELAYS_MS=0,1000,10000,60000,300000,1800000,7200000,21600000,43200000,86400000
# BANK_PROVIDER_LEASE_MS=30000
# Local Node pump interval. Cloudflare uses Durable Object alarms instead.
# BANK_PROVIDER_PUMP_MS=1000
# Local development only. Never enable for a non-loopback provider gateway.
# BANK_PROVIDER_ALLOW_INSECURE_LOCALHOST=false

# Shared hosts must leave outbound webhook delivery disabled. Self-hosters may opt
# in only with an exact HTTPS hostname allowlist; redirects are never followed.
WEBHOOK_DELIVERY_MODE=disabled
# WEBHOOK_ALLOWED_HOSTS=hooks.example.org,events.example.org
# WEBHOOK_MAX_CONCURRENCY=4
# Durable outbox retry schedule in milliseconds. Delivery is at-least-once;
# receivers must deduplicate using x-webhook-delivery-id.
# WEBHOOK_RETRY_DELAYS_MS=0,1000,10000,60000,300000,1800000
# WEBHOOK_LEASE_MS=30000
# Local Node pump interval. Cloudflare uses Durable Object alarms instead.
# WEBHOOK_PUMP_MS=1000

# --- Site (Vite) ---
VITE_API_BASE=http://localhost:5290

# Browser-safe local reference FX connection. Never embed a production key in a
# public Vite build.
VITE_FX_NODE_BASE=http://127.0.0.1:8788

# --- Canonical FX node (apps/fx-node) ---
FX_NODE_MODE=reference-sandbox
FX_NODE_HOST=127.0.0.1
FX_NODE_PORT=8788
FX_NODE_API_KEY=bb_test_local_fx
FX_NODE_DATA_DIR=./.data/fx-reference
FX_NODE_CORS_ORIGINS=http://localhost:5280,http://127.0.0.1:5280
