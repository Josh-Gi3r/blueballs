# Copy to .env and adjust only when needed. The complete local reference stack
# runs without this file.

# --- General banking API (apps/api) ---
PORT=5290
# DB_PATH=./apps/api/blueballs.sqlite

# --- Site (Vite) ---
VITE_API_BASE=http://localhost:5290

# Browser-safe local reference FX connection. Never embed a production key in a
# public Vite build.
VITE_FX_NODE_BASE=http://127.0.0.1:8788
VITE_FX_NODE_KEY=bb_test_local_fx

# --- Canonical FX node (apps/fx-node) ---
FX_NODE_MODE=reference-sandbox
FX_NODE_HOST=127.0.0.1
FX_NODE_PORT=8788
FX_NODE_API_KEY=bb_test_local_fx
FX_NODE_DATA_DIR=./.data/fx-reference
FX_NODE_CORS_ORIGINS=http://localhost:5280,http://127.0.0.1:5280
