# Copy to .env and adjust if you need to. Everything has a sane default —
# you do not need this file to run Blueballs locally.

# --- API (apps/api) ---
# Port the API listens on.
PORT=5290

# Where the SQLite database file lives. Defaults next to apps/api/src.
# DB_PATH=./apps/api/blueballs.sqlite

# --- Site (Vite, root) ---
# Base URL the site's browser client calls for the API. Must be reachable
# from the browser, not just from the server.
VITE_API_BASE=http://localhost:5290
