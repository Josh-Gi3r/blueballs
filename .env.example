# Copy to .env and adjust only when needed. The local stack starts in sandbox
# mode; production mode activates deployment-owned provider and execution adapters.

# --- General banking API (apps/api) ---
PORT=5290
# DB_PATH=./apps/api/blueballs.sqlite
BANK_API_MODE=sandbox
# Fresh production databases bootstrap an institution admin credential from the
# deployment secret manager. Use at least 32 characters and rotate it into the
# institution's normal IAM lifecycle after bootstrap.
# BANK_BOOTSTRAP_API_KEY=
# BANK_BOOTSTRAP_TENANT_ID=
# BANK_BOOTSTRAP_EMAIL=
RATE_LIMIT_PER_MIN=300
# SOURCE_RATE_LIMIT_PER_MIN=120
# TENANT_RATE_LIMIT_PER_MIN=300
BODY_LIMIT_BYTES=1048576
CORS_ORIGINS=http://localhost:5280,http://127.0.0.1:5280
TRUST_PROXY=false
# IDEMPOTENCY_TTL_MS=86400000
PAYMENT_LINK_BASE_URL=https://blueballs.tech/pay/
# SHA-256 hex digest of the operator key; never store the clear-text key here.
# OPERATOR_API_KEY_HASH=

# --- Human IAM/session gateway ---
# A deployment-owned OIDC/SAML/passkey gateway can sign short-lived named-human
# assertions for audit, step-up and approval attribution.
# BANK_TRUSTED_ACTOR_SECRET=
# BANK_TRUSTED_ACTOR_MAX_SKEW_SECONDS=300

# --- Banking provider gateway ---
# Bank rails, receiving details, card issuance, identity verification and custody
# use the provider-neutral gateway protocol. Both URL and token are configured
# together from deployment secret storage.
# BANK_PROVIDER_GATEWAY_URL=https://provider-gateway.example.org/blueballs
# BANK_PROVIDER_GATEWAY_TOKEN=
# BANK_PROVIDER_TIMEOUT_MS=10000
#
# Provider-originated settled account/custody events use a dedicated HMAC secret.
# The private route requires the operator credential and a valid event signature.
# BANK_PROVIDER_INBOUND_SECRET=
# BANK_PROVIDER_INBOUND_MAX_SKEW_SECONDS=300
#
# Durable provider payloads and webhook signing material are sealed with
# AES-256-GCM before persistence. Keys decode to exactly 32 bytes.
# BANK_PROVIDER_PAYLOAD_KEY=
# BANK_PROVIDER_PAYLOAD_ACTIVE_KEY_ID=provider-payload-v1
#
# Rotation keyring example shape (values intentionally omitted):
# BANK_PROVIDER_PAYLOAD_KEYS={"provider-payload-v1":"<32-byte-key>","provider-payload-v2":"<32-byte-key>"}
# BANK_PROVIDER_PAYLOAD_ACTIVE_KEY_ID=provider-payload-v2
#
# Provider retry/reconciliation schedule.
# BANK_PROVIDER_RETRY_DELAYS_MS=0,1000,10000,60000,300000,1800000,7200000,21600000,43200000,86400000
# BANK_PROVIDER_LEASE_MS=30000
# BANK_PROVIDER_PUMP_MS=1000
# BANK_PROVIDER_ALLOW_INSECURE_LOCALHOST=false

# --- Webhooks ---
WEBHOOK_DELIVERY_MODE=disabled
# WEBHOOK_ALLOWED_HOSTS=hooks.example.org,events.example.org
# WEBHOOK_MAX_CONCURRENCY=4
# WEBHOOK_RETRY_DELAYS_MS=0,1000,10000,60000,300000,1800000
# WEBHOOK_LEASE_MS=30000
# WEBHOOK_PUMP_MS=1000

# --- Site (Vite) ---
VITE_API_BASE=http://localhost:5290
VITE_FX_NODE_BASE=http://127.0.0.1:8788

# --- Canonical FX node (apps/fx-node) ---
FX_NODE_MODE=reference-sandbox
FX_NODE_HOST=127.0.0.1
FX_NODE_PORT=8788
FX_NODE_API_KEY=bb_test_local_fx
# Sandbox/reference mode defaults operator/finality authority to FX_NODE_API_KEY.
# Production requires a separate secret for quote confirmation/failure and fiat evidence.
# FX_NODE_OPERATOR_API_KEY=
FX_NODE_DATA_DIR=./.data/fx-reference
FX_NODE_CORS_ORIGINS=http://localhost:5280,http://127.0.0.1:5280

# Production FX composes institution policy, liquidity, fiat evidence and
# execution through one deployment adapter module. Relative paths are resolved
# from the process working directory; package specifiers are supported too.
# FX_NODE_MODE=production
# FX_NODE_PRODUCTION_ADAPTER=./deployment/fx-runtime.mjs
# FX_NODE_API_KEY=<32+ character client/integration API key>
# FX_NODE_OPERATOR_API_KEY=<different 32+ character operator/finality API key>
# FX_NODE_CORS_ORIGINS=https://treasury.example.org
# BLUEBALLS_GIT_SHA=<exact deployed commit>
